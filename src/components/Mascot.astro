---
// Mini cartoon of Naman that perches on page content, hops as you scroll,
// and can be dragged/thrown. Behaviour lives in src/scripts/mascot.ts; this
// file is only the drawing plus the CSS for poses and moods.
---

<div id="mascot" class="mascot" data-mode="perch" data-mood="" role="img" aria-label="Mini cartoon of Naman. Drag me around!">
  <div class="m-inner">
    <svg viewBox="0 0 48 60" class="m-svg" aria-hidden="true">
      <!-- Legs + shoes (each leg swings from the hip) -->
      <g class="m-leg m-leg-l">
        <rect x="17.5" y="48" width="4.6" height="8" rx="2" fill="#c98d68" />
        <ellipse cx="19.2" cy="57" rx="3.9" ry="2.1" fill="#2b2b2b" />
      </g>
      <g class="m-leg m-leg-r">
        <rect x="25.9" y="48" width="4.6" height="8" rx="2" fill="#c98d68" />
        <ellipse cx="28.8" cy="57" rx="3.9" ry="2.1" fill="#2b2b2b" />
      </g>

      <g class="m-body">
        <!-- Shorts -->
        <path d="M15.2 43.5h17.6v6.3a1.4 1.4 0 0 1-1.4 1.4h-6.2l-1.2-3.4-1.2 3.4h-6.2a1.4 1.4 0 0 1-1.4-1.4z" fill="#e6dcc2" stroke="#1c1410" stroke-width=".6" />

        <!-- Arms: sleeve + hand, rotate from the shoulder -->
        <g class="m-arm m-arm-l">
          <rect x="9.6" y="33" width="4.8" height="10.5" rx="2.4" fill="#c98d68" stroke="#1c1410" stroke-width=".5" />
          <path d="M9.3 33.5a2.8 2.8 0 0 1 5.4-.6l.3 4.2-5.6.4z" fill="#8a7965" stroke="#1c1410" stroke-width=".5" />
        </g>
        <g class="m-arm m-arm-r">
          <rect x="33.6" y="33" width="4.8" height="10.5" rx="2.4" fill="#c98d68" stroke="#1c1410" stroke-width=".5" />
          <path d="M38.7 33.5a2.8 2.8 0 0 0-5.4-.6l-.3 4.2 5.6.4z" fill="#8a7965" stroke="#1c1410" stroke-width=".5" />
        </g>

        <!-- Shirt with the white squiggle print from the photo -->
        <path d="M14 32.2Q24 29.4 34 32.2L35 45.2Q24 46.6 13 45.2Z" fill="#8a7965" stroke="#1c1410" stroke-width=".6" />
        <g fill="none" stroke="#f4efe6" stroke-width=".75" stroke-linecap="round">
          <path d="M16.2 36.2c1.6-1.8 2.6 1.6 4.2-.2s1.8-1.4 2.6.4" />
          <path d="M25.4 40.2c1.4-1.4 2.6 1.6 4 0 .8-.9 1.6-.4 2.2.4" />
          <path d="M16.6 42.4c1.8.9 2.8-1.1 4.6 0" />
          <path d="M27 35.2c1 1.1 2.2-1 3.2.1" />
          <path d="M21.6 44c.6-1.2 1.6-1.2 2.2 0" />
        </g>
        <!-- Collar -->
        <path d="M20.6 31.3 24 35.2l3.4-3.9" fill="none" stroke="#f4efe6" stroke-width=".9" stroke-linejoin="round" />
        <!-- Backpack straps -->
        <rect x="15.4" y="31.6" width="2.3" height="13.4" rx="1" fill="#1b1b1b" />
        <rect x="30.3" y="31.6" width="2.3" height="13.4" rx="1" fill="#1b1b1b" />
        <!-- Sunglasses hanging on the shirt -->
        <g fill="#1b1b1b">
          <ellipse cx="22.6" cy="37.6" rx="1.5" ry="1.1" />
          <ellipse cx="25.4" cy="37.6" rx="1.5" ry="1.1" />
          <rect x="22.6" y="36.9" width="2.8" height=".5" />
        </g>
      </g>

      <!-- Head: tilts from the neck -->
      <g class="m-head">
        <rect x="21.4" y="27.5" width="5.2" height="4.5" fill="#c98d68" />
        <circle cx="11.7" cy="20" r="2.6" fill="#d39a74" stroke="#1c1410" stroke-width=".6" />
        <circle cx="36.3" cy="20" r="2.6" fill="#d39a74" stroke="#1c1410" stroke-width=".6" />
        <ellipse cx="24" cy="19" rx="12.4" ry="11.8" fill="#d39a74" stroke="#1c1410" stroke-width=".7" />
        <!-- Hair with a swept quiff -->
        <path d="M11.6 18.6C10.8 8.6 16.6 4.4 24.4 4.4c7 0 12.6 4 12 13.6-1.6-4.2-4.6-6.4-8.4-6-2.6.3-5.6-1.4-8.2.2-3.4-1-6.6 1.6-8.2 6.4z" fill="#241a15" stroke="#1c1410" stroke-width=".6" />
        <path d="M16.4 8C20.6 2.4 30 2.2 33.4 6.4 29.4 4.6 24.4 5 20.2 7.6z" fill="#241a15" />
        <!-- Brows -->
        <g fill="none" stroke="#241a15" stroke-width="1" stroke-linecap="round">
          <path d="M16.9 16.1q2.6-1.3 5.2 0" />
          <path d="M25.9 16.1q2.6-1.3 5.2 0" />
        </g>
        <!-- Blush -->
        <ellipse cx="15.9" cy="25" rx="2.1" ry="1.1" fill="#e9806c" opacity=".45" />
        <ellipse cx="32.1" cy="25" rx="2.1" ry="1.1" fill="#e9806c" opacity=".45" />

        <!-- Eyes: open (pupils follow the cursor) -->
        <g class="m-eyes-open">
          <g class="m-eye-l">
            <ellipse cx="19.5" cy="20.6" rx="2.7" ry="3" fill="#fff" />
            <g class="m-pupil"><circle cx="19.5" cy="20.8" r="1.7" fill="#1f1a17" /><circle cx="20.1" cy="20" r=".6" fill="#fff" /></g>
          </g>
          <g class="m-eye-r">
            <ellipse cx="28.5" cy="20.6" rx="2.7" ry="3" fill="#fff" />
            <g class="m-pupil"><circle cx="28.5" cy="20.8" r="1.7" fill="#1f1a17" /><circle cx="29.1" cy="20" r=".6" fill="#fff" /></g>
          </g>
        </g>
        <!-- Alternate eyes per mood -->
        <g class="m-eyes-happy" fill="none" stroke="#1f1a17" stroke-width="1.3" stroke-linecap="round">
          <path d="M17 21.4q2.5-3.2 5 0" /><path d="M26 21.4q2.5-3.2 5 0" />
        </g>
        <g class="m-eyes-closed" fill="none" stroke="#1f1a17" stroke-width="1.2" stroke-linecap="round">
          <path d="M17 20.6q2.5 2 5 0" /><path d="M26 20.6q2.5 2 5 0" />
        </g>
        <g class="m-eyes-dizzy" fill="none" stroke="#1f1a17" stroke-width=".9" stroke-linecap="round">
          <path d="M19.5 20.6m-2.3 0a2.3 2.3 0 1 1 2.3 2.3 1.4 1.4 0 1 1-1.4-1.4" />
          <path d="M28.5 20.6m-2.3 0a2.3 2.3 0 1 1 2.3 2.3 1.4 1.4 0 1 1-1.4-1.4" />
        </g>
        <path class="m-wink" d="M26 21.4q2.5-3.2 5 0" fill="none" stroke="#1f1a17" stroke-width="1.3" stroke-linecap="round" />

        <!-- Mouths -->
        <path class="m-mouth-smile" d="M21 25.4q3 2.8 6 0" fill="none" stroke="#5a2e22" stroke-width="1.1" stroke-linecap="round" />
        <path class="m-mouth-grin" d="M20.6 24.9q3.4 5.2 6.8 0z" fill="#5a2e22" />
        <ellipse class="m-mouth-o" cx="24" cy="26.3" rx="1.6" ry="2" fill="#5a2e22" />
      </g>

      <!-- Sleep z's -->
      <g class="m-z" fill="#94a3b8" font-family="ui-monospace, monospace" font-weight="700">
        <text x="37" y="9" font-size="6">z</text>
        <text x="41" y="3" font-size="4.5">z</text>
      </g>
    </svg>
  </div>
</div>

<style>
  .mascot {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 30;
    width: 44px;
    height: 55px;
    touch-action: none; /* let pointer events drive dragging on touch screens */
    user-select: none;
    -webkit-user-select: none;
    will-change: transform;
    visibility: hidden; /* shown once the script has placed it */
    /* The drawing uses fixed colours; opt it out of any browser-applied
       dark mode or forced colours so he looks the same in every theme. */
    color-scheme: only light;
    forced-color-adjust: none;
  }
  .mascot[data-ready] { visibility: visible; }
  .m-inner {
    width: 100%;
    height: 100%;
    transform-origin: 50% 100%;
    transition: transform 0.15s ease-out;
  }
  .mascot[data-facing="left"] .m-inner { transform: scaleX(-1); }
  .m-svg { width: 100%; height: 100%; overflow: visible; }

  /* Pivot points for limbs and head */
  .m-leg-l { transform-origin: 19.8px 48px; transform-box: view-box; }
  .m-leg-r { transform-origin: 28.2px 48px; transform-box: view-box; }
  .m-arm-l { transform-origin: 12px 34px; transform-box: view-box; transition: transform 0.2s; }
  .m-arm-r { transform-origin: 36px 34px; transform-box: view-box; transition: transform 0.2s; }
  .m-head { transform-origin: 24px 30px; transform-box: view-box; transition: transform 0.3s; }
  .m-pupil { transform: translate(var(--px, 0px), var(--py, 0px)); transition: transform 0.12s; }

  /* Default face; moods swap parts in and out */
  .m-eyes-happy, .m-eyes-closed, .m-eyes-dizzy, .m-wink,
  .m-mouth-grin, .m-mouth-o, .m-z { display: none; }

  .mascot[data-mood="happy"] .m-eyes-open,
  .mascot[data-mood="sleep"] .m-eyes-open,
  .mascot[data-mood="dizzy"] .m-eyes-open { display: none; }
  .mascot[data-mood="happy"] .m-eyes-happy { display: inline; }
  .mascot[data-mood="happy"] .m-mouth-smile,
  .mascot[data-mood="wink"] .m-mouth-smile { display: none; }
  .mascot[data-mood="happy"] .m-mouth-grin,
  .mascot[data-mood="wink"] .m-mouth-grin { display: inline; }
  .mascot[data-mood="wink"] .m-eye-r { display: none; }
  .mascot[data-mood="wink"] .m-wink { display: inline; }
  .mascot[data-mood="surprised"] .m-mouth-smile,
  .mascot[data-mood="dizzy"] .m-mouth-smile { display: none; }
  .mascot[data-mood="surprised"] .m-mouth-o,
  .mascot[data-mood="dizzy"] .m-mouth-o { display: inline; }
  .mascot[data-mood="surprised"] .m-eyes-open { transform: scale(1.12); transform-origin: 24px 20.6px; transform-box: view-box; }
  .mascot[data-mood="dizzy"] .m-eyes-dizzy { display: inline; animation: m-spin 0.6s linear infinite; transform-origin: 24px 20.6px; transform-box: view-box; }
  .mascot[data-mood="sleep"] .m-eyes-closed,
  .mascot[data-mood="sleep"] .m-z { display: inline; }
  .mascot[data-mood="sleep"] .m-z { animation: m-float 2.4s ease-in-out infinite; }
  .mascot[data-mood="sleep"] .m-head { transform: rotate(-8deg) translateY(1px); }
  .mascot[data-mood="sleep"] .m-body { animation: m-breathe 2.4s ease-in-out infinite; transform-origin: 24px 45px; transform-box: view-box; }

  /* Blink: squash the open eyes for a moment */
  .mascot[data-blink] .m-eyes-open { transform: scaleY(0.1); transform-origin: 24px 20.6px; transform-box: view-box; }

  /* Poses per movement mode */
  .mascot[data-mode="walk"] .m-leg-l { animation: m-step 0.36s ease-in-out infinite; }
  .mascot[data-mode="walk"] .m-leg-r { animation: m-step 0.36s ease-in-out infinite reverse; }
  .mascot[data-mode="walk"] .m-inner { animation: m-bob 0.18s ease-in-out infinite alternate; }
  .mascot[data-mode="walk"][data-facing="left"] .m-inner { animation-name: m-bob-left; }
  .mascot[data-mode="drag"] .m-arm-l,
  .mascot[data-mode="fall"] .m-arm-l,
  .mascot[data-mode="jump"] .m-arm-l { transform: rotate(150deg); }
  .mascot[data-mode="drag"] .m-arm-r,
  .mascot[data-mode="fall"] .m-arm-r,
  .mascot[data-mode="jump"] .m-arm-r { transform: rotate(-150deg); }
  .mascot[data-mode="drag"] .m-leg-l { animation: m-dangle 0.5s ease-in-out infinite alternate; }
  .mascot[data-mode="drag"] .m-leg-r { animation: m-dangle 0.5s ease-in-out infinite alternate-reverse; }
  .mascot[data-wave] .m-arm-r { animation: m-wave 0.35s ease-in-out 3 alternate; }
  .mascot[data-land] .m-inner { animation: m-squash 0.25s ease-out; }
  .mascot[data-land][data-facing="left"] .m-inner { animation-name: m-squash-left; }

  @keyframes m-step { 0%, 100% { transform: rotate(18deg); } 50% { transform: rotate(-18deg); } }
  @keyframes m-dangle { from { transform: rotate(14deg); } to { transform: rotate(-14deg); } }
  @keyframes m-wave { from { transform: rotate(-150deg); } to { transform: rotate(-110deg); } }
  @keyframes m-bob { from { transform: translateY(0); } to { transform: translateY(-1.5px); } }
  @keyframes m-bob-left { from { transform: scaleX(-1) translateY(0); } to { transform: scaleX(-1) translateY(-1.5px); } }
  @keyframes m-squash { 0% { transform: scale(1.12, 0.86); } 100% { transform: scale(1, 1); } }
  @keyframes m-squash-left { 0% { transform: scale(-1.12, 0.86); } 100% { transform: scale(-1, 1); } }
  @keyframes m-spin { to { transform: rotate(360deg); } }
  @keyframes m-float { 0%, 100% { transform: translateY(0); opacity: 0.9; } 50% { transform: translateY(-2px); opacity: 0.5; } }
  @keyframes m-breathe { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(1.03); } }

  @media (prefers-reduced-motion: reduce) {
    .mascot *, .m-inner { animation: none !important; transition: none !important; }
  }
</style>

<script>
  import { startMascot } from "../scripts/mascot";
  startMascot();
</script>
