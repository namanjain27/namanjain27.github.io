---
import type { Item } from "../data/site";

interface Props {
  heading: string;
  items: Item[];
  index: number;
}
const { heading, items, index } = Astro.props;
const linkClass = "slide-underline text-left text-sm text-neutral-900 dark:text-neutral-100";
---

<section class="reveal space-y-3" style={`--i:${index}`}>
  <h2 class="font-mono text-xs uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
    {heading}
  </h2>
  <ul class="relative ml-[6px] space-y-3 border-l border-dotted border-neutral-300 py-1 pl-5 dark:border-neutral-600">
    {
      items.map((item) => (
        <li class="relative">
          {/* Dotted curve connecting each item to the vertical rail */}
          <svg
            aria-hidden="true"
            viewBox="0 0 20 16"
            class="pointer-events-none absolute -left-5 top-0 h-4 w-5 overflow-visible text-neutral-300 opacity-50 dark:text-neutral-600"
          >
            <path
              d="M 0.5 0 C 0.5 11, 2 13, 18 13"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-dasharray="1.5 2.5"
              stroke-linecap="round"
            />
          </svg>
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            {item.description ? (
              // Rows with a description are toggles; the panel below opens/closes on click.
              <button
                type="button"
                class="expand-toggle group inline-flex items-baseline gap-1.5 text-left text-sm text-neutral-900 dark:text-neutral-100"
                aria-expanded="false"
              >
                <span class="slide-underline">{item.title}</span>
                <svg
                  viewBox="0 0 16 16"
                  class="h-3 w-3 shrink-0 self-center text-neutral-400 transition-transform duration-300 group-aria-expanded:rotate-90"
                  aria-hidden="true"
                >
                  <path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            ) : item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                {item.title}
              </a>
            ) : (
              <span class="text-sm text-neutral-900 dark:text-neutral-100">{item.title}</span>
            )}
            <span class="shrink-0 text-xs text-neutral-400 opacity-60 sm:text-sm dark:text-neutral-500">
              {item.meta}
            </span>
          </div>
          {item.description && (
            // Animating grid rows 0fr -> 1fr gives a smooth height transition without measuring.
            <div class="expand-panel">
              <div class="overflow-hidden">
                <p class="pt-2 text-sm leading-relaxed text-neutral-500 dark:text-neutral-400">{item.description}</p>
              </div>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</section>

<script>
  // One delegated listener handles every expandable row on the page.
  document.addEventListener("click", (e) => {
    const toggle = (e.target as Element).closest<HTMLButtonElement>(".expand-toggle");
    if (!toggle) return;
    const panel = toggle.closest("li")?.querySelector<HTMLElement>(".expand-panel");
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    panel?.toggleAttribute("data-open", open);
  });
</script>
