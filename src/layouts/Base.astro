---
import "../styles/global.css";
import { profile } from "../data/site";

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Tells mobile browsers (Chrome/Samsung auto dark) the site has its own
         dark theme, so they don't force-invert colours like the mascot's -->
    <meta name="color-scheme" content="light dark" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@jainnaman_27" />
    <!-- Runs before paint to avoid a light/dark flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          var d = t === "dark" || (t !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
          if (d) document.documentElement.classList.add("dark");
          document.documentElement.style.colorScheme = d ? "dark" : "light";
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-white font-sans text-neutral-900 antialiased dark:bg-zinc-950 dark:text-neutral-100">
    <slot />
  </body>
</html>
